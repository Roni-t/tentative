# Tentative Environment Configuration
# Copy to .env (gitignored) before running docker compose: cp .env.example .env
# The secrets below are public sample values. Replace them for any real deployment.

# Database
DATABASE_URL=sqlite:////app/data/tentative.db

# Cryptography & Security
# SECRET_KEY used for signing JWT session tokens
SECRET_KEY=tentative-celestial-production-secret-key-2026
# FERNET_KEY must be 32 url-safe base64-encoded bytes for encrypting phone numbers at rest
FERNET_KEY=dGVudGF0aXZlLWZlcm5ldC1zZWNyZXQtMzItYnl0ZXM=
PHONE_HASH_SALT=tentative_space_salt_2026

# SMS Provider Adapter ('console' or 'twilio')
SMS_PROVIDER=twilio

# Twilio Credentials (Required only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Business Logic Defaults
DEFAULT_SEMESTER_END_DATE=2026-12-18
SEED_ON_STARTUP=true
# 'development' exposes SMS verification codes to the client, even with twilio
ENVIRONMENT=production

# Seeded Admin Account
ADMIN_NAME=Admin Commander
ADMIN_PHONE=+19725550100
